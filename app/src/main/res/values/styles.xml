<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kalaiya" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/mukta</item>
        <item name="fontFamily">@font/mukta</item>
    </style>

    <style name="Theme.Kalaiya.Splash" parent="Theme.Kalaiya">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/mukta_semibold</item>
        <item name="fontFamily">@font/mukta_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
